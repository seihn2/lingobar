# Server-side template only. Do not serve this file or paste keys into browser configuration.
# The executable does NOT load this file automatically. An operator must supply private process environment.
WEB_ENABLED=0
# Independent text-only mode: needs DeepSeek+Access, no microphone or ASR key.
WEB_TEXT_ENABLED=0
# Use the SAME existing PR17 cumulative1CNY ledger directory, never a fresh budget.
GATEWAY_TEXT_LEDGER_DIRECTORY=
GATEWAY_PORT=8788
GATEWAY_PUBLIC_ORIGIN=
ACCESS_ISSUER=
ACCESS_AUDIENCE=
ACCESS_ALLOWED_EMAIL=
GATEWAY_STATE_DIRECTORY=
# Explicit authorization required: each session reserves 5 min and 40 completion attempts;
# standalone ruby retry reserves 2 attempts. No default paid usage and no automatic refunds.
GATEWAY_DAILY_SESSIONS=0
GATEWAY_DAILY_COMPLETION_REQUESTS=0
ASR_MODEL=qwen3-asr-flash-realtime
ASR_API_KEY=
TRANSLATION_API_KEY=

# Optional existing private JSON {"apiKey":"..."}; explicit file takes precedence over environment key.
# Owner may save through the existing Access-protected HTTPS settings form.
# Contains only a path, never a key; not read by browser or static assets.
TRANSLATION_API_KEY_FILE=

# Separate NEW 2026-10-30 audio+associated translation <=1 CNY test batch.
# Must be privately initialized explicitly; never point at/reset the OLD text ledger.
GATEWAY_AUDIO_LEDGER_DIRECTORY=
# Optional ASR JSON key setting through owner Access route; no NLS AppKey needed.
ASR_API_KEY_FILE=
# Even WEB_ENABLED=1 remains budget-unverified until reviewed billing evidence.

# Application accounts / BYOK is a separate, DISABLED-by-default rollout.
# Keep Cloudflare Access on owner management paths; do not open public routes yet.
APP_AUTH_ENABLED=0
APP_ACCOUNTS_DIRECTORY=
APP_SHARED_BUDGET_DIRECTORY=
# New public/shared funding requires separate authorization, NOT either owner test budget.
APP_SHARED_LIMIT_MICRO_CNY=0
# Operator must first verify provider's applicable free-quota-stop guarantee.
# This is an explicit deployment attestation, not proof inferred from having free credits.
APP_SHARED_ASR_FREE_STOP_VERIFIED=0
