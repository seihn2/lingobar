# Server-side template only. Do not serve this file or paste keys into browser configuration.
# The executable does NOT load this file automatically. An operator must supply private process environment.
WEB_ENABLED=0
# Independent text-only mode: needs DeepSeek+Access, no microphone or ASR key.
WEB_TEXT_ENABLED=0
# Use the SAME existing PR17 cumulative1CNY ledger directory, never a fresh budget.
GATEWAY_TEXT_LEDGER_DIRECTORY=
GATEWAY_PORT=8788
GATEWAY_PUBLIC_ORIGIN=
ACCESS_ISSUER=
ACCESS_AUDIENCE=
ACCESS_ALLOWED_EMAIL=
GATEWAY_STATE_DIRECTORY=
# Explicit authorization required: each session reserves 5 min and 40 completion attempts;
# standalone ruby retry reserves 2 attempts. No default paid usage and no automatic refunds.
GATEWAY_DAILY_SESSIONS=0
GATEWAY_DAILY_COMPLETION_REQUESTS=0
ASR_MODEL=qwen-audio-3.1-asr-flash-streaming
ASR_API_KEY=
TRANSLATION_API_KEY=

# Optional existing private JSON {"apiKey":"..."}; explicit file takes precedence over environment key.
# Owner may save through the existing Access-protected HTTPS settings form.
# Contains only a path, never a key; not read by browser or static assets.
TRANSLATION_API_KEY_FILE=
