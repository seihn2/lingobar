{
  // Example only. There is deliberately no deploy script, account ID, route, auth service binding or secret.
  "name": "lingobar-web-preview",
  "main": "./index.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "WEB_ENABLED": "0", "ASR_MODEL": "qwen-audio-3.1-asr-flash-streaming" },
  "assets": { "directory": "../web", "binding": "ASSETS", "run_worker_first": ["/api/*", "/app-config.json"] }
}
