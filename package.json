{
  "name": "lingobar",
  "version": "0.1.5",
  "private": true,
  "description": "A floating multilingual caption bar for macOS and Windows.",
  "author": "LingoBar",
  "license": "CC-BY-NC-4.0",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test src/renderer/reading-schedule.test.mjs",
    "benchmark:captions": "node scripts/benchmark-captions.cjs",
    "benchmark:snapshot:serialization": "node scripts/benchmark-snapshot-serialization.cjs",
    "benchmark:snapshot:ipc": "node scripts/benchmark-snapshot-ipc.cjs",
    "test:ui": "node scripts/test-ui.cjs",
    "test:dictionary-ui": "node scripts/test-dictionary-ui.cjs",
    "build:dictionary-samples": "node scripts/build-dictionary-samples.cjs",
    "prepare:dictionary-text": "node scripts/prepare-kaikki-text.cjs",
    "validate:dictionary-scale": "node scripts/validate-dictionary-scale.cjs",
    "test:offline-dictionaries": "node scripts/test-offline-dictionaries.cjs",
    "test:media-permissions": "node scripts/test-media-permissions.cjs",
    "test:windows-native": "node scripts/verify-windows-system-audio.cjs",
    "build:icons": "node scripts/make-windows-icons.cjs",
    "build:native": "node scripts/build-native.cjs",
    "build": "npm run typecheck && electron-vite build",
    "package:mac": "npm run build:native && npm run build && electron-builder --mac --dir --publish never",
    "package:win": "npm run build:icons && npm run build:native && npm run build && electron-builder --win --x64 --publish never",
    "verify:package": "node scripts/verify-package.cjs",
    "archive:mac": "node scripts/archive-macos.cjs",
    "checksums:win": "node scripts/checksums-windows.cjs",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "test:web": "vitest run test/web-",
    "test:web-ui": "node scripts/test-web-ui.cjs",
    "verify:web": "node scripts/verify-web.cjs",
    "build:worker": "node scripts/build-worker.cjs",
    "test:worker": "vitest run test/worker-",
    "verify:worker": "node scripts/verify-worker.cjs"
  },
  "devDependencies": {
    "@types/node": "22.17.2",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "43.8.3",
    "electron-builder": "25.1.8",
    "electron-vite": "4.0.0",
    "lucide-react": "0.540.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2",
    "vite": "7.2.2",
    "vitest": "3.2.6",
    "ws": "8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seihn2/lingobar.git"
  },
  "bugs": {
    "url": "https://github.com/seihn2/lingobar/issues"
  },
  "homepage": "https://github.com/seihn2/lingobar#readme"
}
