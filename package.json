{
  "name": "lingobar",
  "version": "0.1.5",
  "private": true,
  "description": "A floating multilingual caption bar for macOS.",
  "author": "LingoBar",
  "license": "CC-BY-NC-4.0",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test src/renderer/reading-schedule.test.mjs",
    "build:native": "node scripts/build-native.cjs",
    "build": "npm run typecheck && electron-vite build",
    "package:mac": "npm run build:native && npm run build && electron-builder --mac --dir --publish never"
  },
  "devDependencies": {
    "@types/node": "22.17.2",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "43.8.3",
    "electron-builder": "25.1.8",
    "electron-vite": "4.0.0",
    "lucide-react": "0.540.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2",
    "vite": "7.2.2",
    "vitest": "3.2.6",
    "ws": "8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seihn2/lingobar.git"
  },
  "bugs": {
    "url": "https://github.com/seihn2/lingobar/issues"
  },
  "homepage": "https://github.com/seihn2/lingobar#readme"
}
